# Copy to .env.local and fill in. .env.local is gitignored.

# ── Supabase ──────────────────────────────────────────────────────────
# Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/scripts only (full access) — never expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (OPTIONAL) ─────────────────────────────────────────────
# Only used by the on-demand "Summarize" narrative (Phase 5). Pipeline needs 0 LLM calls.
ANTHROPIC_API_KEY=

# ── Mock PCC API ─────────────────────────────────────────────────────
PCC_BASE_URL=https://hackathon.prod.pulsefoundry.ai
